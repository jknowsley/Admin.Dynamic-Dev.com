@page "/conversations"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Conversations</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Conversations</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?" Label="Filter by Project" @bind-Value="_selectedProjectId" Clearable="true">
                @if (_projects != null)
                {
                    @foreach (var project in _projects)
                    {
                        <MudSelectItem Value="@((int?)project.Id)">@project.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadConversations">Apply Filter</MudButton>
            @if (_selectedProjectId.HasValue)
            {
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearFilter" Class="ml-2">Clear</MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_conversations == null || !_conversations.Any())
{
    <MudAlert Severity="Severity.Info">No conversations found.</MudAlert>
}
else
{
    @foreach (var dateGroup in _groupedConversations)
    {
        <MudExpansionPanels Class="mb-2">
            <MudExpansionPanel IsInitiallyExpanded="@(dateGroup.Key == _groupedConversations.First().Key)">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="mr-3" />
                        <MudText Typo="Typo.h6">@dateGroup.Key.ToString("dddd, MMMM d, yyyy")</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-3">@dateGroup.Count() conversations</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @foreach (var projectGroup in dateGroup.GroupBy(c => c.ProjectName ?? "Unknown").OrderBy(g => g.Key))
                    {
                        <MudPaper Class="pa-3 mb-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <div class="d-flex align-center mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.subtitle1"><strong>@projectGroup.Key</strong></MudText>
                            </div>
                            
                            @foreach (var conv in projectGroup)
                            {
                                <MudPaper Class="pa-3 mb-2 conversation-item" Elevation="1" @onclick="@(() => NavigateToConversation(conv.Id))" Style="cursor: pointer;">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center" style="flex: 1; min-width: 0;">
                                            <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" Color="Color.Secondary" Class="mr-2" />
                                            <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @(conv.Summary ?? $"Conversation #{conv.Id}")
                                            </MudText>
                                        </div>
                                        <div class="d-flex align-center flex-shrink-0 ml-2">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@conv.MessageCount msgs</MudChip>
                                            @if (conv.TokenCount.HasValue)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">@conv.TokenCount.Value.ToString("N0") tokens</MudChip>
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                                           Size="Size.Small" 
                                                           Color="Color.Primary" 
                                                           Class="ml-1"
                                                           OnClick="@(() => NavigateToConversation(conv.Id))"
                                                           OnClickStopPropagation="true" />
                                        </div>
                                    </div>
                                </MudPaper>
                            }
                        </MudPaper>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@if (!_loading && _hasMore)
{
    <div class="d-flex justify-center mt-4 mb-6">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMore">
            Load More
        </MudButton>
    </div>
}

@code {
    private List<ConversationListItem>? _conversations;
    private List<Project>? _projects;
    private int? _selectedProjectId;
    private bool _loading = true;
    private bool _hasMore;
    private int _page = 1;
    private const int PageSize = 30;
    private IEnumerable<IGrouping<DateOnly, ConversationListItem>> _groupedConversations = Enumerable.Empty<IGrouping<DateOnly, ConversationListItem>>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await Http.GetFromJsonAsync<List<Project>>("api/projects");
            await LoadConversations();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private async Task LoadConversations()
    {
        _loading = true;
        try
        {
            _page = 1;
            var url = $"api/conversations?page=1&pageSize={PageSize}";
            if (_selectedProjectId.HasValue)
                url += $"&projectId={_selectedProjectId}";
                
            _conversations = await Http.GetFromJsonAsync<List<ConversationListItem>>(url) ?? new();
            _hasMore = _conversations.Count == PageSize;
            
            _groupedConversations = _conversations
                .GroupBy(c => c.Date)
                .OrderByDescending(g => g.Key);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading conversations: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearFilter()
    {
        _selectedProjectId = null;
        await LoadConversations();
    }

    private async Task LoadMore()
    {
        if (_loading || !_hasMore)
            return;

        _loading = true;
        try
        {
            var nextPage = _page + 1;
            var url = $"api/conversations?page={nextPage}&pageSize={PageSize}";
            if (_selectedProjectId.HasValue)
                url += $"&projectId={_selectedProjectId}";

            var more = await Http.GetFromJsonAsync<List<ConversationListItem>>(url) ?? new();
            if (more.Any())
            {
                _page = nextPage;
                _conversations ??= new();
                _conversations.AddRange(more);
                _groupedConversations = _conversations
                    .GroupBy(c => c.Date)
                    .OrderByDescending(g => g.Key);
            }

            _hasMore = more.Count == PageSize;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more conversations: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateToConversation(int id)
    {
        Navigation.NavigateTo($"/conversation/{id}");
    }
}
