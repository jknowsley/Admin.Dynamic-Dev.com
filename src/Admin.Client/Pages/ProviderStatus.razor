@page "/provider-status"
@attribute [Authorize]
@using Admin.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http

<PageTitle>Provider Status</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">AI Provider Status & Usage</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Live-ish view from OpenClaw session history for Claude, GPT, and Gemini.</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var provider in _providers)
        {
            <MudItem xs="12" md="4">
                <MudCard Class="pa-2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@provider.DisplayName</MudText>
                            <MudChip T="string" Color="@(provider.IsHealthy ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small">
                                @provider.Status
                            </MudChip>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="provider-stats">
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Requests</MudText>
                                <MudText Typo="Typo.body2">@provider.Requests</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Errors</MudText>
                                <MudText Typo="Typo.body2">@provider.Errors</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Total Tokens</MudText>
                                <MudText Typo="Typo.body2">@FormatNumber(provider.TotalTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Input Tokens</MudText>
                                <MudText Typo="Typo.body2">@FormatNumber(provider.InputTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Output Tokens</MudText>
                                <MudText Typo="Typo.body2">@FormatNumber(provider.OutputTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Cache Read</MudText>
                                <MudText Typo="Typo.body2">@FormatNumber(provider.CacheReadTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Cost</MudText>
                                <MudText Typo="Typo.body2">@provider.TotalCost.ToString("C")</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2">Last Used</MudText>
                                <MudText Typo="Typo.body2">@FormatTimestamp(provider.LastUsed)</MudText>
                            </div>
                        </div>

                        @if (provider.Models.Any())
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Models</MudText>
                            @foreach (var model in provider.Models.Take(3))
                            {
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.body2">@model.Name</MudText>
                                    <MudText Typo="Typo.body2">@model.Requests</MudText>
                                </div>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(provider.LastError))
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Last Error</MudText>
                            <MudText Typo="Typo.caption">@provider.LastError</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ProviderUsageStats> _providers = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await Http.GetFromJsonAsync<List<ProviderUsageStats>>("api/provider-status") ?? new();

            if (_providers.Count == 0)
            {
                _error = "The API returned no provider rows. That usually means the server couldn't read the OpenClaw session history on the host.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatNumber(long value) => value.ToString("N0");

    private static string FormatTimestamp(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";
        return DateTime.TryParse(value, out var dt) ? dt.ToLocalTime().ToString("g") : value;
    }
}
