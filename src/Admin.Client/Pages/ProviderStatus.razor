@page "/provider-status"
@attribute [Authorize]
@using Admin.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http

<PageTitle>Provider Status</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">AI Provider Status & Usage</MudText>
<MudText Typo="Typo.body1" Class="mb-4">View provider health and usage for Today, Last 7 Days, or a custom date range.</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudSelect T="string" Label="Range" Value="@_selectedRange" ValueChanged="OnRangeChanged">
                <MudSelectItem T="string" Value="@RangeToday">Today</MudSelectItem>
                <MudSelectItem T="string" Value="@RangeLast7Days">Last 7 Days</MudSelectItem>
                <MudSelectItem T="string" Value="@RangeDateRange">Date Range</MudSelectItem>
            </MudSelect>
        </MudItem>

        @if (_selectedRange == RangeDateRange)
        {
            <MudItem xs="12" md="3">
                <MudDatePicker Label="Start Date" Date="@_startDate" DateChanged="OnStartDateChanged" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="End Date" Date="@_endDate" DateChanged="OnEndDateChanged" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadProviders">Apply</MudButton>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var provider in _providers)
        {
            <MudItem xs="12" md="4">
                <MudCard Class="pa-2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@provider.DisplayName</MudText>
                            <MudChip T="string" Color="@(provider.IsHealthy ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small">
                                @provider.Status
                            </MudChip>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="provider-stats">
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Requests</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@provider.Requests</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Errors</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@provider.Errors</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Total Tokens</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@FormatNumber(provider.TotalTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Input Tokens</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@FormatNumber(provider.InputTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Output Tokens</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@FormatNumber(provider.OutputTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Cache Read</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@FormatNumber(provider.CacheReadTokens)</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Cost</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@provider.TotalCost.ToString("C")</MudText>
                            </div>
                            <div class="provider-stat-row">
                                <MudText Typo="Typo.body2" Class="provider-stat-label">Last Used</MudText>
                                <MudText Typo="Typo.body2" Class="provider-stat-value">@FormatTimestamp(provider.LastUsed)</MudText>
                            </div>
                        </div>

                        @if (provider.Models.Any())
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Models</MudText>
                            @foreach (var model in provider.Models.Take(3))
                            {
                                <div class="provider-stat-row">
                                    <MudText Typo="Typo.body2" Class="provider-stat-label">@model.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="provider-stat-value">@model.Requests</MudText>
                                </div>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(provider.LastError))
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Last Error</MudText>
                            <MudText Typo="Typo.caption">@provider.LastError</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private const string RangeToday = "today";
    private const string RangeLast7Days = "last7days";
    private const string RangeDateRange = "daterange";

    private List<ProviderUsageStats> _providers = new();
    private bool _loading = true;
    private string? _error;
    private string _selectedRange = RangeToday;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = new DateTime(2026, 1, 1);

    protected override async Task OnInitializedAsync()
    {
        _startDate = new DateTime(2026, 1, 1);
        _endDate = DateTime.Today;
        await LoadProviders();
    }

    private async Task OnRangeChanged(string value)
    {
        _selectedRange = value;
        if (_selectedRange != RangeDateRange)
            await LoadProviders();
    }

    private Task OnStartDateChanged(DateTime? value)
    {
        _startDate = value;
        return Task.CompletedTask;
    }

    private Task OnEndDateChanged(DateTime? value)
    {
        _endDate = value;
        return Task.CompletedTask;
    }

    private async Task LoadProviders()
    {
        _loading = true;
        _error = null;

        try
        {
            var url = $"api/provider-status?range={_selectedRange}";
            if (_selectedRange == RangeDateRange)
            {
                if (!_startDate.HasValue || !_endDate.HasValue)
                {
                    _error = "Please select both a start and end date.";
                    return;
                }

                var startUtc = DateTime.SpecifyKind(_startDate.Value.Date, DateTimeKind.Utc);
                var endUtc = DateTime.SpecifyKind(_endDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);
                url += $"&startUtc={Uri.EscapeDataString(startUtc.ToString("O"))}&endUtc={Uri.EscapeDataString(endUtc.ToString("O"))}";
            }

            _providers = await Http.GetFromJsonAsync<List<ProviderUsageStats>>(url) ?? new();

            if (_providers.Count == 0)
                _error = "No provider usage snapshots were found for that range yet. Run the local sync again to populate it.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatNumber(long value) => value.ToString("N0");

    private static string FormatTimestamp(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";
        return DateTime.TryParse(value, out var dt) ? dt.ToLocalTime().ToString("g") : value;
    }
}
