@page "/tasks"
@attribute [Authorize]
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Task Board</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h4">Task Board</MudText>
    <div class="d-flex align-center gap-2">
        <MudSelect T="int?" Label="Project" @bind-Value="_filterProjectId" Clearable="true" Dense="true" Style="width: 200px;">
            @if (_projects != null)
            {
                @foreach (var p in _projects)
                {
                    <MudSelectItem Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                }
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreateDialog">New Task</MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="kanban-board">
        @foreach (var column in _columns)
        {
            <div class="kanban-column">
                <div class="kanban-column-header" style="@GetColumnHeaderStyle(column)">
                    <MudText Typo="Typo.subtitle1"><strong>@column</strong></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@GetTasksForColumn(column).Count()</MudChip>
                </div>
                <div class="kanban-column-body">
                    @foreach (var task in GetTasksForColumn(column))
                    {
                        <MudPaper Class="kanban-card pa-3 mb-2" Elevation="2" @onclick="@(() => ShowEditDialog(task))">
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(task.Priority)" Variant="Variant.Filled">@task.Priority</MudChip>
                                @if (task.Project != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@task.Project.Name</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.body1" Class="mb-1"><strong>@task.Title</strong></MudText>
                            @if (!string.IsNullOrEmpty(task.BranchName))
                            {
                                <div class="d-flex align-center gap-1 mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@task.BranchName</MudText>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">@task.Description</MudText>
                            }
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudText Typo="Typo.caption">@task.AssignedTo</MudText>
                                @if (task.DueDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="@(task.DueDate.Value < DateOnly.FromDateTime(DateTime.Today) ? Color.Error : Color.Default)">
                                        @task.DueDate.Value.ToString("MMM d")
                                    </MudText>
                                }
                            </div>
                            <div class="d-flex gap-1 mt-2">
                                @if (column != "Backlog")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="@(() => MoveTask(task, -1))" OnClickStopPropagation="true" Title="Move Left" />
                                }
                                @if (column != "Done")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" OnClick="@(() => MoveTask(task, 1))" OnClickStopPropagation="true" Title="Move Right" />
                                }
                            </div>
                        </MudPaper>
                    }
                </div>
            </div>
        }
    </div>
}

@* Create/Edit Task Dialog *@
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Edit" : "New") Task</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editTask.Title" Label="Title" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="int?" @bind-Value="_editTask.ProjectId" Label="Project" Clearable="true" Variant="Variant.Outlined">
                    @if (_projects != null)
                    {
                        @foreach (var p in _projects)
                        {
                            <MudSelectItem Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_editTask.BranchName" Label="Branch Name" Variant="Variant.Outlined" Placeholder="e.g., DEV-BOT01-feature" />
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="string" @bind-Value="_editTask.Priority" Label="Priority" Variant="Variant.Outlined">
                    @foreach (var p in TaskPriority.All)
                    {
                        <MudSelectItem Value="@p">@p</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="string" @bind-Value="_editTask.Status" Label="Status" Variant="Variant.Outlined">
                    @foreach (var s in Admin.Shared.Models.TaskStatus.All)
                    {
                        <MudSelectItem Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="string" @bind-Value="_editTask.AssignedTo" Label="Assigned To" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Fred")">Fred</MudSelectItem>
                    <MudSelectItem Value="@("Jonathan")">Jonathan</MudSelectItem>
                    <MudSelectItem Value="@("Both")">Both</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editTask.Description" Label="Description / Task Details" Lines="4" Variant="Variant.Outlined" Placeholder="What needs to be done? Include any context, file paths, or specific requirements..." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editTask.AcceptanceCriteria" Label="Acceptance Criteria" Lines="3" Variant="Variant.Outlined" Placeholder="How do we know this is done? e.g., - Users can filter by date&#10;- Results show in under 2 seconds" />
            </MudItem>
            @if (_isEdit)
            {
                <MudItem xs="6">
                    <MudTextField @bind-Value="_editTask.CommitHash" Label="Commit Hash" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_editTask.PRUrl" Label="PR URL" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editTask.Notes" Label="Notes / Progress Updates" Lines="3" Variant="Variant.Outlined" Placeholder="Fred can update progress here..." />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (_isEdit)
        {
            <MudButton Color="Color.Error" OnClick="DeleteTask" Class="mr-auto">Delete</MudButton>
        }
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveTask">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TaskItem>? _tasks;
    private List<Project>? _projects;
    private bool _loading = true;
    private bool _dialogVisible = false;
    private bool _isEdit = false;
    private TaskItem _editTask = new();
    private int? _filterProjectId;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private readonly string[] _columns = Admin.Shared.Models.TaskStatus.All;

    protected override async Task OnInitializedAsync()
    {
        _projects = await Http.GetFromJsonAsync<List<Project>>("api/projects");
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        _loading = true;
        try
        {
            var url = "api/tasks";
            if (_filterProjectId.HasValue)
                url += $"?projectId={_filterProjectId}";
            _tasks = await Http.GetFromJsonAsync<List<TaskItem>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<TaskItem> GetTasksForColumn(string status)
    {
        return _tasks?.Where(t => t.Status == status) ?? Enumerable.Empty<TaskItem>();
    }

    private void ShowCreateDialog()
    {
        _isEdit = false;
        _editTask = new TaskItem
        {
            Status = Admin.Shared.Models.TaskStatus.Backlog,
            Priority = TaskPriority.Medium,
            AssignedTo = "Fred",
            ProjectId = _filterProjectId
        };
        _dialogVisible = true;
    }

    private void ShowEditDialog(TaskItem task)
    {
        _isEdit = true;
        _editTask = new TaskItem
        {
            Id = task.Id,
            Title = task.Title,
            Description = task.Description,
            Status = task.Status,
            Priority = task.Priority,
            AssignedTo = task.AssignedTo,
            BranchName = task.BranchName,
            AcceptanceCriteria = task.AcceptanceCriteria,
            Notes = task.Notes,
            CommitHash = task.CommitHash,
            PRUrl = task.PRUrl,
            ProjectId = task.ProjectId,
            DueDate = task.DueDate,
            KanbanOrder = task.KanbanOrder
        };
        _dialogVisible = true;
    }

    private void CloseDialog() => _dialogVisible = false;

    private async Task SaveTask()
    {
        try
        {
            if (_isEdit)
            {
                await Http.PutAsJsonAsync($"api/tasks/{_editTask.Id}", _editTask);
                Snackbar.Add("Task updated!", Severity.Success);
            }
            else
            {
                await Http.PostAsJsonAsync("api/tasks", _editTask);
                Snackbar.Add("Task created!", Severity.Success);
            }
            _dialogVisible = false;
            await LoadTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteTask()
    {
        await Http.DeleteAsync($"api/tasks/{_editTask.Id}");
        _dialogVisible = false;
        Snackbar.Add("Task deleted", Severity.Warning);
        await LoadTasks();
    }

    private async Task MoveTask(TaskItem task, int direction)
    {
        var currentIndex = Array.IndexOf(_columns, task.Status);
        var newIndex = currentIndex + direction;
        if (newIndex < 0 || newIndex >= _columns.Length) return;

        var update = new { Status = _columns[newIndex] };
        await Http.PatchAsJsonAsync($"api/tasks/{task.Id}/status", update);
        await LoadTasks();
    }

    private string GetColumnHeaderStyle(string column) => column switch
    {
        "Backlog" => "border-bottom: 3px solid #9e9e9e;",
        "To Do" => "border-bottom: 3px solid #2196f3;",
        "In Progress" => "border-bottom: 3px solid #ff9800;",
        "Review" => "border-bottom: 3px solid #9c27b0;",
        "Done" => "border-bottom: 3px solid #4caf50;",
        _ => ""
    };

    private Color GetPriorityColor(string priority) => priority switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        "Low" => Color.Default,
        _ => Color.Default
    };
}
